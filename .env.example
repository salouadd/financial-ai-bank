# Local development only. Never use these sample values in production.
POSTGRES_DB=coach_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-only-change-me
APP_PORT=8082
MAX_HTTP_REQUEST_SIZE=65536
AI_ANALYSES_PER_MINUTE=5
SALARY_DETECTIONS_PER_MINUTE=10
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=mock-key-for-dev
JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
JWT_ISSUER=https://identity.example.test
JWT_AUDIENCE=financial-coach-service
SERVICES_TRANSACTION_SERVICE_BASE_URL=http://host.docker.internal:8083
SCA_PROVIDER_ENABLED=false
SCA_PROVIDER_BASE_URL=
SCA_PROVIDER_API_TOKEN=
